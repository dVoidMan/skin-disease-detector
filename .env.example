# Flask Application Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration
# Default: Local SQLite database
DATABASE_URL=sqlite:///database/skin_disease.db
# MySQL Example:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/skin_disease_db

# Local Upload Settings
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# Cloudflare R2 Storage (S3-Compatible)
# Set to 'true' to enable uploading user scans to Cloudflare R2
CLOUDFLARE_R2_ENABLED=false
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=skin-disease-images
# Optional: Public URL / Custom domain for direct image access
# e.g., https://pub-xxxxxxxxxxxxxx.r2.dev or https://images.yourdomain.com
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# (Optional) Multimodal Vision AI API - Google Gemini 1.5 Flash Vision
# Get a free API key at: https://aistudio.google.com
# When set, DermAI automatically routes lesion scans to Gemini Vision for medical-grade AI analysis
GEMINI_API_KEY=
